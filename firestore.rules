rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User data sync (existing) - each user can only read/write their own data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // OTA content metadata - any authenticated user can read
    match /content_meta/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // admin SDK only
    }

    // OTA content files - any authenticated user can read
    match /content_files/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // admin SDK only
    }
  }
}
