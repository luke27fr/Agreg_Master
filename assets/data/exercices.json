      "enonce": "Trouver u, v ∈ ℤ tels que 17u + 23v = 1.",
      "indication": "Algorithme d'Euclide étendu.",
      "solution": [
        "23 = 1×17 + 6",
        "17 = 2×6 + 5",
        "6 = 1×5 + 1",
        "Remontée : 1 = 6 - 5 = 6 - (17 - 2×6) = 3×6 - 17 = 3×23 - 4×17",
        "u = -4, v = 3. Vérif : -68 + 69 = 1 ✓"
      ],
      "lecons": [142],
      "tags": ["arithmétique", "Bézout"]
    },
