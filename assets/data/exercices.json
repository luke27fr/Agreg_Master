      "titre": "Somme de deux carrés (Gauss)",
      "domaine": "Algèbre",
      "niveau": "Moyen",
      "enonce": "Décomposer 65 et 145 en sommes de deux carrés.",
      "indication": "Factoriser dans ℤ[i].",
      "solution": [
        "65 = 5×13 = (2+i)(2-i)(3+2i)(3-2i).",
        "(2+i)(3+2i) = 4+7i ⟹ 65 = 4² + 7²",
        "(2+i)(3-2i) = 8-i ⟹ 65 = 8² + 1²",
        "145 = 5×29 : (2+i)(5+2i) = 8+9i ⟹ 145 = 8² + 9²",
        "(2+i)(5-2i) = 12+i ⟹ 145 = 12² + 1²"
      ],
      "lecons": [122, 126],
      "tags": ["Gauss", "somme de carrés"]
    },
